{
    admin off
    persist_config off
    auto_https off

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges
    }
}

:{$PORT:80} {
    log {
        format json
    }

    respond /health 200

    # Security headers
    header {
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-eval' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
        -Server
    }

    # Cache en el CDN y en el navegador
    @imagenes path *.png *.jpg *.jpeg *.gif *.svg *.webp *.ico *.woff *.woff2 *.ttf *.otf *.eot
    header @imagenes Cache-Control "public, max-age=604800"
    @codigo path *.js *.css
    header @codigo Cache-Control "public, max-age=3600"

    # Proxy a la API del banco (User-Agent de navegador obligatorio)
    reverse_proxy /Api-portalDavivienda/* https://www.davivienda.com.sv {
        header_up Host www.davivienda.com.sv
        header_up Origin https://www.davivienda.com.sv
        header_up Referer https://www.davivienda.com.sv/
        header_up User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        header_up Accept "application/json, text/plain, */*"
        header_up Accept-Language "es-ES,es;q=0.9,en;q=0.8"
    }

    root * .

    file_server {
        hide .git
        hide .env*
    }

    encode {
        gzip
        zstd
    }

    try_files {path} {path}.html {path}/index.html

    handle_errors {
        rewrite * /{err.status_code}.html
        file_server
    }
}
