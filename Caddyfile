{
    admin off
    persist_config off
    auto_https off

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges
    }
}

:{$PORT:80} {
    log {
        format json
    }

    respond /health 200

    # Security headers
    header {
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-eval' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
        -Server
    }

    # Proxy a la API del banco (evita CORS y el 403 de Incapsula)
    reverse_proxy /Api-portalDavivienda/* https://www.davivienda.com.sv {
        header_up Host www.davivienda.com.sv
        header_up Origin https://www.davivienda.com.sv
    }

    root * .

    file_server {
        hide .git
        hide .env*
    }

    encode {
        gzip
        zstd
    }

    try_files {path} {path}.html {path}/index.html

    handle_errors {
        rewrite * /{err.status_code}.html
        file_server
    }
}
